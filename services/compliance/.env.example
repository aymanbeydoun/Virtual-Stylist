# BFL Compliance & Audit Agent
COMPLIANCE_ENVIRONMENT=development

# "stub" = canned deterministic reports (no API key needed, dev/tests only).
# "anthropic" = real audits against the Claude API (required in production).
COMPLIANCE_AUDIT_BACKEND=stub
COMPLIANCE_ANTHROPIC_API_KEY=
COMPLIANCE_AUDIT_MODEL=claude-opus-4-8
COMPLIANCE_AUDIT_MAX_OUTPUT_TOKENS=32000

COMPLIANCE_MAX_FILES_PER_AUDIT=15
COMPLIANCE_MAX_FILE_BYTES=20971520
COMPLIANCE_MAX_TOTAL_BYTES=23068672
